{
  "name": "nv-request-marker",
  "version": "1.0.0",
  "description": "combines and marks pdf for keywords",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --dir",
    "pack": "electron-packager . PDF-Marker --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "PDFmarker",
    "productName": "PDF Marker",
    "win": {
      "target": "dir",
      "icon": "pdf-marker.ico"
    },
    "electronLanguages": ["en-US", "zh-CN"],
    "files": [
      "User_Interface/**/*",
      "preload.js",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "PDFMarkerApp",
        "to": "PDFMarkerApp"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
