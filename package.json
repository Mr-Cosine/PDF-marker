{
  "name": "nv-request-marker",
  "version": "0.0.0",
  "description": "marks pdf for keywords for nv requests",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pdf_marker",
    "productName": "PDF Marker",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "./TesseractOCR",
        "to": "TesseractOCR",
        "filter": ["**/*"]
      }
    ]
  }
}
