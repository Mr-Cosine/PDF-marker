{
  "name": "nv-request-marker",
  "version": "0.0.0",
  "description": "combines and marks pdf for keywords",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yourcompany.pdfmarker",
    "productName": "PDF Marker",
    "win": {
      "target": "portable"
    },
    "files": [
      "User_Interface/**/*",
      "preload.js",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "PDFmarker.py",
        "to": "PDFmarker.py"
      },
      {
        "from": "TesseractOCR",
        "to": "TesseractOCR"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
